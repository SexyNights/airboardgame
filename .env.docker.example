# Copy to .env.docker and edit.

# Public URL users open in the browser
CLIENT_URL=http://localhost:8262

# Long random string; generate with: openssl rand -hex 32
ABG_SECRET=change-me

# Comma-separated emails allowed to log in (empty = anyone)
ABG_ALLOWED_EMAILS=

# "fake" = no mail is sent (login links go to the backend log)
EMAIL_HOST=fake
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
# Sender address (default: noreply@<CLIENT_URL host>)
EMAIL_FROM=

# Example: Resend (the sender domain must be verified in Resend)
#EMAIL_HOST=smtp.resend.com
#EMAIL_PORT=465
#EMAIL_USER=resend
#EMAIL_PASSWORD=re_xxxxxxxxxxxxxxxx
#EMAIL_FROM=abg@example.com
